mapscripts Lago_Wild_Area_MapScripts {
MAP_SCRIPT_ON_TRANSITION: HideMapNameLagoWA
MAP_SCRIPT_ON_RESUME: NightmareModeOFF 
MAP_SCRIPT_ON_RESUME: Script_MaxLv20

}
script 	HideMapNameLagoWA{
	setflag(FLAG_HIDE_MAP_NAME_POPUP)
}

  script Lago_Wild_Area_Sign{
     msgbox(format("Tip 5: Ricordati di guarire i tuoi pokemon usando i mirtilli. Se sarai sconfitta, ricomncerai dal pumto dove hai mangiato i mirtilli"))
  closemessage
  }


script Lago_Wild_Area_Sign_EventScript_Mirtilli{
    lockall
    specialvar(VAR_RESULT,CheckPartyFullHealed)
    if(var(VAR_RESULT)){
        msgbox(format("Oh una pianta di mirtilli, fa miracoli!"))
     }elif(!var(VAR_RESULT)){
        msgbox(format("Mirtilli selvatici! Non c'e' nulla di meglio per curare tutti i mali"))
         msgbox("I tuoi Pokemon sono guariti")
        special(HealPlayerParty)
        setrespawn(HEAL_LOCATION_LagoWild_Mirtilli)
   }
   	releaseall

}


script Lago_Wild_EventScript_Emanuele{
msgbox(format("EMANUELE: Come abbiamo fatto ad arrivare fino a qui?! Conosciamo tutti i passaggi"), MSGBOX_NPC)
closemessage
call(ViaFrancEast_EventScript_postBattle)
	
}

script LoagoWild_Donato{
specialvar(VAR_RESULT,CalculatePlayerPartyCount) 
if(var(VAR_RESULT)>1){ 
		lockall
 		msgbox(Donato_text_cancella_pkm, MSGBOX_YESNO)
		 if (var(VAR_RESULT) != 1) {
                msgbox(format("DONATO:Ok, torno ad allenarmi"))
			
                
            }elif (var(VAR_RESULT) == 1) {
				msgbox(format("DONATO:Seleziona il tuo pkm"))
				special(ChoosePartyMon)
				waitstate
				special(ChoosePartyMon)
				waitstate
				if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN){
    		 
					msgbox( format("DONATO: Ok sara' per la prossima volta"))
				}
				else{
    				special(DeleteChosenPartyMon)
					msgbox(format("DONATO: Il tuo pokemon e' tormato libero"))
					msgbox(format("DONATO: eccoti anche la pokeball in cui si trovava"))
					giveitem(ITEM_POKE_BALL)
				}

			}
		closemessage
		releaseall
	 
}
 
msgbox(format("DONATO:Hai visto come sono stato veloce. Altre due flessioni e ci facciamo altri due arrosticini"))
closemessage
}


script Lago_Wild_Area_EventScript_Jackson{

	trainerbattle_single(TRAINER_JACKSON_1, Battle_Text_LagoJackson,after_Battle_Text_LagoJackson)
	msgbox(format("GUARDIA FORESTALE: Che guardi?! Sto lavorando duramente! Mi raccomando fai attenzione ai cinghiali!"), MSGBOX_NPC)
	closemessage

	
}
text 	Battle_Text_LagoJackson{
format("GUARDIA FORESTALE: Hey tu dove vai! Fammi vedere i documenti! Non vuoi?! Allora combattiamo!")

}
text after_Battle_Text_LagoJackson{
format("GUARDIA FORESTALE: Hai vinto, fammi tornare al mio duro lavoro!")
	
}
script Lago_Wild_Area_EventScript_Catherine{

	trainerbattle_single(TRAINER_CATHERINE_1, Battle_Text_LagoCatherine,after_Battle_Text_LagoCatherine)
	msgbox(format("GUARDIA FORESTALE:Che duro lavoro il mio! Salvare il lago da tutti questi malfattori"), MSGBOX_NPC)
	closemessage

	
}
text 	Battle_Text_LagoCatherine{
format("GUARDIA FORESTALE: Hey dove vai! Sei una delinquente? Combattiamo!")
}
text after_Battle_Text_LagoCatherine{
format("GUARDIA FORESTALE: Hai vinto, ma non mi inganni, lo so che sei una delinquente!")
}

script Lago_Wild_Area_EventScript_Chris{

	trainerbattle_single(TRAINER_CHRIS, Battle_Text_Lago_Chris,after_Battle_Text_Lago_Chris)
	msgbox(format("PINGUINO: Puoi togliere un uomo dal lago ma mai un lago dall'uomo"), MSGBOX_NPC)
	closemessage

	
}
text 	Battle_Text_Lago_Chris{
format("PINGUINO: Se ti batto dovrai mettere l'olio sul culo della modella")
	
}
text after_Battle_Text_Lago_Chris{
format("PINGUINO: Niente olio questa volta")
}

script Lago_Wild_Area_EventScript_Giada{
	
    trainerbattle_single(TRAINER_HEIDI, Battle_Text_Lago_Giada,after_Battle_Text_Lago_Giada)
	    if(flag(FLAG_POKE_BALL_GIADA)){
            msgbox(format("GIADA: C’est vraiment une belle journée. Ce serait l’idéal d’avoir un vélo pour faire une belle balade. J’ai vu Ciro passer à vélo comme une fusée !!"), MSGBOX_NPC)
	
        }else{
            msgbox(format("Visto che mi hai battuta ti regalo questa"), MSGBOX_NPC)
            giveitem(ITEM_POKE_BALL)
            setflag(FLAG_POKE_BALL_GIADA)
            addvar(VAR_NUM_POKEBALL,1)
        }

	closemessage


	
}
text 	Battle_Text_Lago_Giada{
format("GIADA:Coucou Alice, comment ça va ? Regarde-moi ce soleil de fou !!!!!
Je me régale dans la nature ! La tour Eiffel, c’est sympa, hein… mais franchement, vuoi mette Posta Fibreno ? ")
	
}
text after_Battle_Text_Lago_Giada{
format("GIADA: Nooooo ho perso!")
}

script Lago_Wild_Area_EventScript_Ciro{
        if(checkitem(ITEM_BIKE_VOUCHER)){
	msgbox(format("CIRO: Ho proprio voglia di correre. Una corsetta da qui in Norvegia penso possa andare bene"), MSGBOX_NPC)
 
        }else{
          	msgbox(format("CIRO: Ciao Alice, mi sto scaldando.\p"
			"Oggi corro solo millemila chilometri. Ah! a proposito non e' che ti puoi prendere cura della mia bici. L'ho lasciata nelle mani del vecchio scorbutico, ma non mi fido"), MSGBOX_NPC)
 
        giveitem(ITEM_BIKE_VOUCHER)      
        }
	closemessage	
	
}


