mapscripts Autostrada_MapScripts {
MAP_SCRIPT_ON_TRANSITION: HideMapNameIndoor_Autostr
MAP_SCRIPT_ON_RESUME: NightmareModeOFF 
MAP_SCRIPT_ON_RESUME: Script_MaxLv25

}
script 	HideMapNameIndoor_Autostr{
	setflag(FLAG_HIDE_MAP_NAME_POPUP)
}

script DLC_carnello{
	msgbox(format("La DLC Carnjl non e' ancora disponibile. Non ti posso lasciar passare"), MSGBOX_NPC)
	closemessage
}



script GuardiaForestale_bikeroad{
 
 
 msgbox(format("Puoi salire sulla pista ciclabile solo se hai una bicicletta!!!!!"),MSGBOX_NPC)
  closemessage
}

script temp_trigger {
    msgbox(format("triggering temp_trigger"),MSGBOX_DEFAULT)

    if(flag(FLAG_SYS_CYCLING_ROAD)){
         msgbox(format("FLAG_SYS_CYCLING_ROAD is TRUE. non si puo scendere dalla bici: setto la flag a FALSE"),MSGBOX_DEFAULT)
        clearflag(FLAG_SYS_CYCLING_ROAD)
        applymovement(OBJ_EVENT_ID_PLAYER,script_mov_cycledown)

    }elif(flag(FLAG_SYS_CYCLING_ROAD)==FALSE){
         msgbox(format("FLAG_SYS_CYCLING_ROAD is FALSE, controllo il player"),MSGBOX_DEFAULT)
        specialvar(VAR_RESULT, GetPlayerAvatarBike)
        if (var(VAR_RESULT)==0){
            msgbox(format("Fplayer non sulla bici"),MSGBOX_DEFAULT)
            call(Route110_SeasideCyclingRoadSouthEntrance_EventScript_NoBike)
        }elif(var(VAR_RESULT)==1){
               msgbox(format("Player  sulla bici setting FLAG_SYS_CYCLING_ROAD to true "),MSGBOX_DEFAULT)
               setflag(FLAG_SYS_CYCLING_ROAD)
               applymovement(OBJ_EVENT_ID_PLAYER,script_mov_cycleup)
        }
    }
    closemessage
 
}
movement script_mov_cycleup{
	walk_up 
}

movement script_mov_cycledown{
	walk_down
}



 
